FROM python:3.11-slim

ARG UPSTREAM_REF=v0.3.2
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UPSTREAM_DIR=/opt/watermarks-remover

RUN apt-get update \
    && apt-get install -y --no-install-recommends git exiftool ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${UPSTREAM_REF}" \
    https://github.com/guillaumemeyer/watermarks-remover.git \
    /opt/watermarks-remover

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt

COPY app.py /app/app.py
COPY README_DEPLOY.md /app/README_DEPLOY.md
COPY UPSTREAM_LICENSE.txt /app/UPSTREAM_LICENSE.txt

RUN useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 80
CMD ["python", "/app/app.py"]
